ARG NODE_IMAGE=node@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
ARG BUN_IMAGE=oven/bun@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f
ARG MIGRATION_NODE_IMAGE=node@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @e-mate/analytics-api build \
 && pnpm --filter @e-mate/model-gateway build \
 && pnpm --filter @e-mate/auth-gateway build

FROM ${BUN_IMAGE} AS analytics
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --gid 0 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin emate
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:0 /app/node_modules ./node_modules
COPY --from=build --chown=10001:0 /app/apps/analytics-api ./apps/analytics-api
COPY --from=build --chown=10001:0 /app/packages ./packages
USER 10001:0
RUN bun -e "await import('./apps/analytics-api/dist/production.js')"
EXPOSE 4190
CMD ["bun", "apps/analytics-api/dist/production.js"]

FROM ${BUN_IMAGE} AS gateway
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:0 /app/node_modules ./node_modules
COPY --from=build --chown=10001:0 /app/apps/model-gateway ./apps/model-gateway
COPY --from=build --chown=10001:0 /app/packages ./packages
USER 10001:0
RUN bun -e "await import('./apps/model-gateway/dist/production.js')"
EXPOSE 4191
CMD ["bun", "apps/model-gateway/dist/start.js"]

FROM ${BUN_IMAGE} AS auth
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:0 /app/node_modules ./node_modules
COPY --from=build --chown=10001:0 /app/apps/auth-gateway ./apps/auth-gateway
COPY --from=build --chown=10001:0 /app/packages ./packages
USER 10001:0
RUN bun -e "await import('./apps/auth-gateway/dist/production.js')"
EXPOSE 4192
CMD ["bun", "apps/auth-gateway/dist/start.js"]

FROM ${BUN_IMAGE} AS skill-hub
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:0 /app/node_modules ./node_modules
COPY --from=build --chown=10001:0 /app/apps/skill-hub-service ./apps/skill-hub-service
COPY --from=build --chown=10001:0 /app/apps/skill-hub-worker ./apps/skill-hub-worker
USER 10001:0
RUN bun -e "await import('./apps/skill-hub-service/src/server.ts')"
EXPOSE 8788
CMD ["bun", "apps/skill-hub-service/src/server.ts"]

# The importer uses Node's restricted SQLite reader; serving stays on the pinned Bun runtime.
FROM ${MIGRATION_NODE_IMAGE} AS skill-hub-migrate
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:0 /app/node_modules ./node_modules
COPY --from=build --chown=10001:0 /app/apps/skill-hub-service ./apps/skill-hub-service
COPY --from=build --chown=10001:0 /app/apps/skill-hub-worker ./apps/skill-hub-worker
USER 10001:0
RUN node --input-type=module -e "import { DatabaseSync } from 'node:sqlite'; if (typeof DatabaseSync.prototype.setAuthorizer !== 'function') throw new Error('Restricted SQLite reader is unavailable')"
ENTRYPOINT ["node", "--experimental-strip-types", "apps/skill-hub-service/src/migrate.ts"]

FROM ${BUN_IMAGE} AS share
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:0 /app/node_modules ./node_modules
COPY --from=build --chown=10001:0 /app/apps/share-service ./apps/share-service
COPY --from=build --chown=10001:0 /app/apps/share-worker ./apps/share-worker
USER 10001:0
RUN bun -e "await import('./apps/share-service/src/server.ts')"
EXPOSE 8789
CMD ["bun", "apps/share-service/src/server.ts"]

FROM ${MIGRATION_NODE_IMAGE} AS share-migrate
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:0 /app/node_modules ./node_modules
COPY --from=build --chown=10001:0 /app/apps/share-service ./apps/share-service
COPY --from=build --chown=10001:0 /app/apps/share-worker ./apps/share-worker
USER 10001:0
ENTRYPOINT ["node", "--experimental-strip-types", "apps/share-service/src/migrate.ts"]
