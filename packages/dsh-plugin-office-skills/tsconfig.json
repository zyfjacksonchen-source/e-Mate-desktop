{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../upstream/deepseek-harness/node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
