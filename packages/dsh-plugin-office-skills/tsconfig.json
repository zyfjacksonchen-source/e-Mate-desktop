{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../..",
    "outDir": "lib",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../upstream/deepseek-harness/node_modules/@types"
    ],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "react": [
        "../../upstream/deepseek-harness/node_modules/.pnpm/node_modules/@types/react"
      ],
      "react/*": [
        "../../upstream/deepseek-harness/node_modules/.pnpm/node_modules/@types/react/*"
      ],
      "@deepseek-ai/dsh-sandbox-policy": [
        "../../upstream/deepseek-harness/packages/sandbox/sandbox-policy/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
