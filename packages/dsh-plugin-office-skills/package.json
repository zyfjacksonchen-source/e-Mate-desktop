{
  "name": "@e-mate/dsh-plugin-office-skills",
  "version": "2.0.18",
  "description": "Support Skills and optional Univer plugin discovery for e-Mate",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "lib",
    "src",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfjacksonchen-source/e-Mate-desktop.git",
    "directory": "packages/dsh-plugin-office-skills"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "typecheck": "../../upstream/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test test/package.test.mjs",
    "test:types": "../../upstream/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "bf7179bf3f62585d84b9b41b8cc1a0fffa1d7866",
    "baseImports": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/dsh-skill"
    ]
  },
  "packageManager": "pnpm@11.8.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.1"
  }
}
