{
  "name": "@e-mate/dsh-plugin-tidychat",
  "version": "2.0.18",
  "description": "Native rc7 tidychat folding and navigation; manual history loading only",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "pnpm-lock.yaml"
  ],
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "typecheck": "../../upstream/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs && ../../upstream/deepseek-harness/node_modules/.bin/vitest --config vitest.config.ts run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "ff9a977890dafc4fe9b05634470db9a33bc9a3ef",
    "baseImports": [
      "@deepseek-ai/dsh-settings",
      "@deepseek-ai/schemastery",
      "react"
    ],
    "upstreamRepository": "https://github.com/BananaSoldier01/dsh-tidychat",
    "upstreamCommit": "dd8bf4fa27049363bc5f9b4692009c912ae2556a",
    "upstreamVersion": "0.2.9"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "jsdom": "29.1.1"
  }
}
