{
  "name": "@e-mate/dsh-plugin-find-skill",
  "version": "2.0.18",
  "description": "e-Mate discovery adapter with allowlisted global external-connection bootstrap",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/types",
    "lib/skills",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/contract.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "yaml": "2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "upstream": {
      "repository": "https://github.com/zyfjacksonchen-source/dsh-find-skill",
      "commit": "e217fb0c8d8e377be6d9c0514446f9455821a79b"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "43c411a51c555e61e9b5f500442cb3404a2d70cd",
    "baseImports": [
      "@deepseek-ai/dsh-home-paths",
      "@deepseek-ai/dsh-skill",
      "@deepseek-ai/dsh-tools",
      "@deepseek-ai/schemastery",
      "react"
    ]
  }
}
