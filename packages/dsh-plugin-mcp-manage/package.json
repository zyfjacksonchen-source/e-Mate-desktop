{
  "name": "@e-mate/dsh-plugin-mcp-manage",
  "version": "2.0.18",
  "description": "DSH-native MCP connection management for e-Mate",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/contract.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@larksuite/cli": "1.0.88"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "d1d095bee770c3e9d302f844083e02f0b74576ee",
    "runtime": "@deepseek-ai/dsh-mcp-client",
    "mcpSdkVersion": "1.29.0",
    "baseImports": [
      "@deepseek-ai/dsh-credentials",
      "@deepseek-ai/dsh-settings",
      "@deepseek-ai/dsh-tools",
      "@deepseek-ai/schemastery"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
