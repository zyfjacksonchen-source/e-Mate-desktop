{
  "name": "@e-mate/dsh-plugin-cdp",
  "version": "2.0.18",
  "description": "DSH-native Chrome DevTools Protocol adapter for e-Mate",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cdp": {
      "types": "./lib/cdp.d.mts",
      "default": "./lib/cdp.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfjacksonchen-source/e-Mate-desktop.git",
    "directory": "packages/dsh-plugin-cdp"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "d1d095bee770c3e9d302f844083e02f0b74576ee",
    "baseImports": [
      "@deepseek-ai/dsh-settings",
      "@deepseek-ai/schemastery"
    ]
  }
}
