{
  "name": "@e-mate/dsh-plugin-pet",
  "version": "2.0.18",
  "private": true,
  "description": "Xiaoxin presentation-only pet on the pinned native DSH overlay and settings owners.",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json" },
  "files": ["lib/", "cordis.patch.yml", "README.md", "SOURCE.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "../../upstream/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/contracts.test.mjs test/native-projection.test.mjs test/resources.test.mjs",
    "test:client": "node ../../upstream/deepseek-harness/node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "validate:assets": "node --experimental-strip-types scripts/validate-assets.ts"
  },
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-ui-slots"], "platform": "web" }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "bf7179bf3f62585d84b9b41b8cc1a0fffa1d7866",
    "upstreamRepository": "https://github.com/npc-dao/dsh-pet",
    "upstreamCommit": "f501139cfb155fd46717a79bb1c158da064dce15",
    "baseImports": ["@deepseek-ai/dsh-settings", "@deepseek-ai/schemastery", "react"],
    "effects": ["persistent-state"],
    "guards": ["explicit-user-action"]
  }
}
