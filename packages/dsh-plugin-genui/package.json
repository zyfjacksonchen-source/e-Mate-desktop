{
  "name": "@e-mate/dsh-plugin-genui",
  "version": "2.0.18",
  "description": "e-Mate 2.0.17 compatibility build of dsh-genui for the pinned local runtime.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
