{
  "name": "@e-mate/dsh-plugin-computer-use",
  "version": "2.0.18",
  "description": "e-Mate native macOS and Windows Computer Use adapter on the pinned rc.7 runtime",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types",
    "native",
    "assets",
    "scripts/build-native.mjs",
    "docs",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test test/contract.test.mjs test/capability-status.test.mjs test/windows-source.test.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "upstream": {
      "repository": "https://github.com/Anionex/dsh-computer-use",
      "commit": "76bfe8607f61945c1cbb84e73976e601100c13a2"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "bf7179bf3f62585d84b9b41b8cc1a0fffa1d7866",
    "windowsPrimitiveSource": {
      "repository": "https://github.com/jing-hy/computer-user",
      "commit": "2fbf383b49fe08e466d4d1caba659fb42b61de6b"
    },
    "baseImports": [
      "@deepseek-ai/cordis",
      "@deepseek-ai/dsh-client-ui-primitives",
      "@deepseek-ai/dsh-llm",
      "@deepseek-ai/dsh-settings",
      "@deepseek-ai/dsh-storage-domain",
      "@deepseek-ai/dsh-tools",
      "@deepseek-ai/schemastery",
      "react"
    ]
  }
}
