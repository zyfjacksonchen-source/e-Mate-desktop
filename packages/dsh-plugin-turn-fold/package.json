{
  "name": "@e-mate/dsh-plugin-turn-fold",
  "version": "2.0.18",
  "private": true,
  "description": "e-Mate 2.0.18 vendored build of dsh-turn-fold, adapted to the pinned DSH 0.1.5-rc.1 client.",
  "license": "MIT",
  "main": "lib/index.cjs",
  "exports": {
    ".": "./lib/index.cjs",
    "./transform": "./lib/transform.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE",
    "pnpm-lock.yaml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:seams": "node scripts/build.mjs --seams-only",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm build && pnpm test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "harmony": {
      "patches": [
        "./lib/patch.cjs"
      ]
    },
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Turn Fold",
        "zh-CN": "Turn Fold"
      },
      "summary": {
        "en": "Collapse each completed turn's agent activity into a summary bar; keep the final answer visible.",
        "zh-CN": "将每个已完成 turn 的 Agent activity 折叠成摘要栏，最终答复保持可见。"
      },
      "category": "ui"
    },
    "upstream": {
      "repository": "CH4ACKO3/dsh-turn-fold",
      "commit": "69867494627d58da4d17f5842bda7d1c36fa34d2",
      "version": "0.6.0"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "43c411a51c555e61e9b5f500442cb3404a2d70cd",
    "baseImports": [
      "@deepseek-ai/schemastery"
    ],
    "seamTarget": "@deepseek-ai/dsh-client-ui-chat/lib/client.js"
  }
}
