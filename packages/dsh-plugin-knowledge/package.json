{
  "name": "@e-mate/dsh-plugin-knowledge",
  "version": "2.0.18",
  "private": true,
  "description": "Native enterprise knowledge page and account-scoped Host RPC over verified public sources.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:client": "node ../../upstream/deepseek-harness/node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "check": "../../upstream/deepseek-harness/node_modules/.bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "4da69d7c3522ee51de12822c917c503a124f7a7d",
    "baseImports": [
      "@deepseek-ai/dsh-agent",
      "@deepseek-ai/dsh-client-ui-primitives",
      "@deepseek-ai/dsh-tools",
      "react"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
