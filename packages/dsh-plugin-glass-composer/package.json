{
  "name": "@e-mate/dsh-plugin-glass-composer",
  "version": "2.0.18",
  "description": "DSH-native animated edge light and palette control for the e-Mate composer.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "upstream": {
      "repository": "VioletYJ/dsh-glass-composer",
      "commit": "ab5d6040d3b81166d108ba35d1978e386a1b9300"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "43c411a51c555e61e9b5f500442cb3404a2d70cd",
    "excludedUpstreamFeatures": [
      "index-html-injection",
      "local-storage-settings",
      "mutation-observer-discovery",
      "backdrop-blur"
    ],
    "baseImports": [
      "@deepseek-ai/dsh-client-ui-primitives",
      "@deepseek-ai/dsh-settings",
      "@deepseek-ai/schemastery",
      "react"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "private": true
}
