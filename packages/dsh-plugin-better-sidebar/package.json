{
  "name": "@e-mate/dsh-plugin-better-sidebar",
  "version": "2.0.18",
  "description": "Project-scoped file sidebar for the pinned e-Mate 2.0.17 local runtime.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "pnpm-lock.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && ../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs && pnpm test:client",
    "test:client": "../../upstream/deepseek-harness/node_modules/.bin/vitest run --config vitest.config.ts",
    "check": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "bf7179bf3f62585d84b9b41b8cc1a0fffa1d7866",
    "excludedUpstreamFeatures": [
      "terminal",
      "node-pty",
      "standalone-websocket",
      "standalone-http-api"
    ],
    "baseImports": [
      "react"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "private": true
}
