{
  "name": "@e-mate/dsh-plugin-harmony",
  "version": "2.0.18",
  "private": true,
  "description": "e-Mate 2.0.18 vendored build of dsh-harmony, the runtime patcher the Path C owners depend on.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bin": "./lib/bin.js",
    "./client": "./browser-dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "assets/",
    "browser-dist/",
    "scripts/install-shim.cjs",
    "scripts/restart.cjs",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE",
    "pnpm-lock.yaml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:seams": "node scripts/build.mjs --seams-only",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm build && pnpm test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "harmony": {
      "patches": [
        "./lib/builtins/client-load-plan.patch.cjs",
        "./lib/builtins/cordis-service-index.patch.cjs",
        "./lib/builtins/settings.patch.cjs",
        "./lib/builtins/session-profile.patch.cjs"
      ]
    },
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Harmony",
        "zh-CN": "Harmony"
      },
      "summary": {
        "en": "Runtime patching, replacing and decorating of DeepSeek Harness plugins.",
        "zh-CN": "在运行时修补、替换和装饰 DeepSeek Harness 插件。"
      },
      "category": "plugin-development"
    },
    "upstream": {
      "package": "dsh-harmony",
      "version": "0.8.10",
      "repository": "memorax-ai/dsh-harmony",
      "gitHead": "44e7de03d6414c5681eb314d1d9f1cfb2e2c9428",
      "tarballSha256": "a45b92a4acb9e71f97c1ab62bdb2ac79974c5429e4bd2631e8afab01af42f4c4"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.5-rc.1",
    "harnessCommit": "d1d095bee770c3e9d302f844083e02f0b74576ee",
    "baseImports": [
      "@deepseek-ai/dsh-settings",
      "@deepseek-ai/schemastery"
    ],
    "seamTargets": [
      "@deepseek-ai/dsh-client-modules/lib/index.js",
      "@deepseek-ai/cordis/lib/index.js",
      "@deepseek-ai/dsh-client-ui-settings-general/lib/client.js",
      "@deepseek-ai/dsh-api-session-controller/lib/client.js"
    ]
  }
}
