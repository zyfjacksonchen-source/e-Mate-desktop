{
  "name": "@e-mate/desktop",
  "version": "2.0.18",
  "description": "e-Mate desktop: an Electron shell composed as a DeepSeek Harness Cordis plugin",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfjacksonchen-source/e-Mate-desktop.git",
    "directory": "desktop/e-mate-desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "e-mate-desktop": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./profile": {
      "types": "./lib/types/profile.d.ts",
      "default": "./lib/profile.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./windows-pwsh-sandbox": {
      "types": "./lib/types/windows-pwsh-sandbox.d.ts",
      "default": "./lib/windows-pwsh-sandbox.js"
    },
    "./windows-directory-picker": {
      "types": "./lib/types/windows-directory-picker.d.ts",
      "default": "./lib/windows-directory-picker.js"
    },
    "./terminal": {
      "types": "./lib/types/terminal.d.ts",
      "default": "./lib/terminal.js"
    },
    "./pnpm": {
      "types": "./lib/types/pnpm.d.ts",
      "default": "./lib/pnpm.js"
    },
    "./profile-service": {
      "types": "./lib/types/profile-service.d.ts",
      "default": "./lib/profile-service.js"
    },
    "./profiles": {
      "types": "./lib/types/profiles.d.ts",
      "default": "./lib/profiles.js"
    },
    "./updates": {
      "types": "./lib/types/updates.d.ts",
      "default": "./lib/updates.js"
    },
    "./agent-update": {
      "types": "./lib/types/agent-update.d.ts",
      "default": "./lib/agent-update.js"
    },
    "./vision-toolkit": {
      "types": "./lib/types/vision-toolkit.d.ts",
      "default": "./lib/vision-toolkit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "base-contract.json",
    "build/e-mate-profile/**",
    "build/harness-runtime-provenance.json",
    "build/app-icon.png",
    "build/app-icon-mac.png",
    "build/tray-icon.svg",
    "build/tray-icon*.png",
    "cordis.patch.yml",
    "docs/**",
    "lib/**/*.cjs",
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "THIRD_PARTY_NOTICES.md",
    "third-party-notices/**"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare:python": "node scripts/prepare-python-runtime.mjs",
    "build": "yarn run prepare:python && yarn run build:sdk",
    "build:sdk": "node ../../scripts/harness-provenance.mjs sync-desktop && node scripts/sync-emate-profile.mjs && node scripts/generate-mac-app-icon.mjs && node scripts/generate-tray-icons.mjs && node scripts/clean.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.tests.client.json --noEmit",
    "test": "vitest run",
    "verify:closure": "node --test scripts/runtime-closure.spec.mjs && node scripts/verify-runtime-closure.mjs",
    "verify:cli": "node scripts/verify-cli-runtime.mjs",
    "verify:loader": "node scripts/verify-loader-boot.mjs",
    "verify:profile": "node scripts/verify-profile-boot.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:notices": "node scripts/verify-licenses.mjs --notices THIRD_PARTY_NOTICES.md",
    "check:source": "yarn run build:sdk && yarn run typecheck && yarn run test && yarn run verify:closure && yarn run verify:cli && yarn run verify:loader && yarn run verify:licenses",
    "check": "yarn run prepare:python && yarn run check:source && yarn run verify:profile",
    "check:win-package": "yarn run build && yarn run typecheck && vitest run tests/e-mate-profile-win.spec.ts tests/electron-runtime.spec.ts tests/package.spec.ts tests/package-win.spec.ts tests/plugin.spec.ts tests/profile.spec.ts tests/update-checker.spec.ts tests/update-download.spec.ts tests/verify-win-installer.spec.ts tests/verify-packaged-runtime.spec.ts tests/windows-directory-picker.spec.ts tests/windows-pwsh-sandbox.spec.ts tests/windows-volume-diagnostics.spec.ts tests/window-options.spec.ts && yarn run verify:closure",
    "check:mac-package": "yarn run build && yarn run typecheck && vitest run tests/mac-universal.spec.ts tests/package.spec.ts tests/package-mac.spec.ts tests/package-win.spec.ts tests/update-checker.spec.ts tests/update-download.spec.ts tests/verify-mac-smoke.spec.ts tests/verify-packaged-runtime.spec.ts tests/verify-win-installer.spec.ts tests/window-options.spec.ts && yarn run verify:closure",
    "start": "node lib/bin.js",
    "dev": "yarn run build && node lib/bin.js",
    "package:dir": "yarn run build && node scripts/package-dir.mjs",
    "dist:mac": "node scripts/package-mac.ts",
    "dist:win": "node scripts/package-win.ts",
    "prepack": "yarn run check"
  },
